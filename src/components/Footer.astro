---
import {
  SITE_NAME,
  ACQUISITION_EMAIL,
  DISCLAIMER,
  buyNowMailto,
  makeOfferMailto,
  contactAgentMailto,
  DOMAIN_PRICE_DISPLAY,
} from '../lib/constants';

const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_96%,black)]">
  <div class="max-w-screen-xl mx-auto px-6 py-16 md:py-20">
    <div
      class="relative overflow-hidden rounded-3xl border border-[color:color-mix(in_oklab,var(--color-neon)_25%,transparent)] bg-gradient-to-br from-[color:var(--color-surface)] via-[color:var(--color-bg)] to-[color:color-mix(in_oklab,var(--color-neon)_8%,transparent)] p-8 md:p-12"
    >
      <div class="relative grid md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-7 space-y-4">
          <p
            class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[2.4px] font-extrabold text-[var(--color-neon)]"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-neon)] animate-pulse"></span>
            Domain available · {DOMAIN_PRICE_DISPLAY} USD
          </p>
          <h2 class="font-display text-3xl sm:text-4xl tracking-tight leading-tight">
            Acquire <span class="gradient-text">aipolyintelligence.com</span>
          </h2>
          <p class="text-[color:var(--color-muted)] max-w-xl text-sm md:text-base leading-relaxed">
            Escrow-protected transfer, clean title, and personal response within 24 hours.
            Choose Buy Now, Make Offer, or Contact Agent.
          </p>
          <nav class="flex flex-wrap gap-4 text-sm pt-2" aria-label="Footer">
            <a href="/#pricing" class="underline-offset-4 hover:underline">Pricing</a>
            <a href="/#faq" class="underline-offset-4 hover:underline">FAQ</a>
            <a href="/blog/" class="underline-offset-4 hover:underline">Domain insights</a>
            <a href="/blog/domain-valuation-guide/" class="underline-offset-4 hover:underline"
              >Valuation guide</a
            >
          </nav>
        </div>

        <div class="md:col-span-5 flex flex-col gap-3 md:items-end">
          <a
            href={buyNowMailto()}
            class="group w-full md:w-auto text-center px-8 py-4 btn-primary rounded-2xl flex items-center justify-center gap-2 min-h-12"
          >
            <span>Buy Now</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 group-hover:translate-x-0.5 transition-transform"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 12h14m-7-7l7 7-7 7"></path>
            </svg>
          </a>
          <a
            href={makeOfferMailto()}
            class="w-full md:w-auto text-center px-8 py-3.5 border border-[color:var(--color-border)] rounded-2xl text-sm font-semibold min-h-12 inline-flex items-center justify-center hover:border-[color:color-mix(in_oklab,var(--color-neon)_50%,transparent)] transition-colors"
          >
            Make Offer
          </a>
          <a
            href={contactAgentMailto()}
            class="w-full md:w-auto text-center px-8 py-3.5 text-sm font-semibold text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)] min-h-12 inline-flex items-center justify-center"
          >
            Contact Agent · {ACQUISITION_EMAIL}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-screen-xl mx-auto px-6 pb-12">
    <p
      class="text-[11px] leading-relaxed text-[color:var(--color-muted)] max-w-4xl border-t border-[color:var(--color-border)] pt-8 opacity-80"
    >
      {DISCLAIMER}
      <span class="block mt-2 opacity-70">Information current as of September 2026.</span>
    </p>

    <div
      class="mt-8 pt-6 border-t border-[color:var(--color-border)] text-xs text-[color:var(--color-muted)] flex flex-col md:flex-row gap-y-4 items-center justify-between"
    >
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="trust-pill">Escrow.com protected</span>
        <span class="trust-pill">HTTPS / TLS</span>
        <span class="trust-pill">Clean title transfer</span>
      </div>
      <div class="text-[10px] text-center md:text-right">
        © {year} {SITE_NAME} · Premium domain marketplace listing
      </div>
    </div>
  </div>
</footer>
