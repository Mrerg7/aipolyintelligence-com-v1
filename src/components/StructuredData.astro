---
import {
  SITE_URL,
  SITE_NAME,
  DOMAIN_NAME,
  DOMAIN_PRICE,
  HERO_IMAGE_URL,
  ACQUISITION_EMAIL,
  SEO,
  BRAND,
} from '../lib/constants';

interface Props {
  includeProduct?: boolean;
}

const { includeProduct = true } = Astro.props;

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: SEO.title,
  description: SEO.description,
  url: `${SITE_URL}/`,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: `${SITE_URL}/`,
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: HERO_IMAGE_URL,
    contentUrl: HERO_IMAGE_URL,
    width: 1200,
    height: 630,
  },
  about: {
    '@type': 'Product',
    name: `${DOMAIN_NAME} domain name`,
  },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.hero-price'],
  },
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND,
  alternateName: SITE_NAME,
  url: `${SITE_URL}/`,
  email: ACQUISITION_EMAIL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
  description: SEO.description,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: ACQUISITION_EMAIL,
    availableLanguage: ['English'],
  },
};

const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${DOMAIN_NAME} domain name`,
  description:
    'Premium .com domain for AI polyintelligence — a rare, high-value digital asset for visionary AI research, multi-agent systems, and next-generation intelligence brands.',
  category: 'Domain Name',
  image: [HERO_IMAGE_URL],
  brand: {
    '@type': 'Brand',
    name: DOMAIN_NAME,
  },
  sku: 'AIPOLY-DOMAIN-001',
  mpn: 'AIPOLY-COM',
  url: `${SITE_URL}/`,
  // Product snippets require one of: offers, review, or aggregateRating.
  // offers-only is intentional: the visible page shows the $199,999 price, and
  // self-submitted review/aggregateRating markup would be self-serving (against
  // Google review-snippet policy and discarded), while shipping/return details
  // are invalid for a digital domain-asset transfer (zero-day transit,
  // finite-window returns with 0 days) and risk invalidating the whole Offer.
  offers: {
    '@type': 'Offer',
    '@id': `${SITE_URL}/#offer`,
    availability: 'https://schema.org/InStock',
    price: String(DOMAIN_PRICE),
    priceCurrency: 'USD',
    priceValidUntil: '2027-12-31',
    itemCondition: 'https://schema.org/NewCondition',
    url: `${SITE_URL}/#pricing`,
    seller: {
      '@type': 'Organization',
      name: BRAND,
      email: ACQUISITION_EMAIL,
      url: `${SITE_URL}/`,
    },
  },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE_URL}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Premium Domains',
      item: `${SITE_URL}/#pricing`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: DOMAIN_NAME,
      item: `${SITE_URL}/`,
    },
  ],
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Is ${DOMAIN_NAME} for sale?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Yes. ${DOMAIN_NAME} is listed for acquisition at $${DOMAIN_PRICE.toLocaleString('en-US')} USD with Escrow.com-protected transfer and clean title.`,
      },
    },
    {
      '@type': 'Question',
      name: 'How does domain transfer work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Transactions are completed through Escrow.com. After payment clears, the domain is pushed to your registrar account. Most transfers complete within 24–48 hours.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I make an offer below the asking price?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Serious offers are reviewed personally. Use Make Offer or Contact Agent — flexible terms may be available for qualified buyers.',
      },
    },
    {
      '@type': 'Question',
      name: 'What makes this a premium investment domain?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It is a brandable .com that names an emerging AI paradigm — polyintelligence — giving the owner narrative ownership as the industry moves beyond narrow AI.',
      },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{includeProduct && <script type="application/ld+json" set:html={JSON.stringify(product)} />}
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
<script type="application/ld+json" set:html={JSON.stringify(faq)} />
