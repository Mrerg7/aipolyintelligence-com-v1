---
import {
  acquisitionMailto,
  buyNowMailto,
  DOMAIN_NAME,
} from '../lib/constants';
---

<nav
  id="nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-[color:var(--color-border)]"
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <a
        href="/"
        class="flex items-center gap-x-2 sm:gap-x-3 min-h-12 min-w-0 relative z-50"
        aria-label={`${DOMAIN_NAME} home`}
      >
        <div
          class="w-9 h-9 shrink-0 rounded-2xl bg-gradient-to-br from-[var(--color-neon)] via-[var(--color-accent)] to-[var(--color-neon)] p-px"
        >
          <div
            class="w-full h-full bg-[var(--color-bg)] rounded-2xl flex items-center justify-center"
          >
            <span class="text-[var(--color-neon)] text-lg font-bold tracking-tighter"
              >AI</span
            >
          </div>
        </div>
        <div
          class="font-display text-base sm:text-xl lg:text-2xl font-semibold tracking-tighter truncate max-w-[42vw] sm:max-w-none"
        >
          {DOMAIN_NAME}
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-x-7 text-base font-medium">
        <a
          href="#positioning"
          class="nav-link inline-flex min-h-12 items-center text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)]"
          >Positioning</a
        >
        <a
          href="#why"
          class="nav-link inline-flex min-h-12 items-center text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)]"
          >Why Buy</a
        >
        <a
          href="#insights"
          class="nav-link inline-flex min-h-12 items-center text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)]"
          >Insights</a
        >
        <a
          href="#pricing"
          class="nav-link inline-flex min-h-12 items-center text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)]"
          >Pricing</a
        >
        <a
          href="/blog/"
          class="nav-link inline-flex min-h-12 items-center text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)]"
          >Blog</a
        >
      </div>

      <div class="relative z-50 flex shrink-0 items-center gap-x-2 sm:gap-x-3">
        <button
          id="theme-toggle"
          type="button"
          class="tap-target inline-flex items-center justify-center rounded-2xl border border-[color:var(--color-border)] hover:bg-[color:var(--color-surface)] transition-colors"
          aria-label="Toggle light and dark mode"
        >
          <svg
            class="theme-icon-dark w-5 h-5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <svg
            class="theme-icon-light w-5 h-5 hidden"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <a
          href="#inquire"
          class="hidden lg:inline-flex min-h-12 items-center justify-center px-5 py-3 text-base font-semibold rounded-2xl border border-[color:var(--color-border)] hover:bg-[color:var(--color-surface)] transition-colors"
        >
          Make Offer
        </a>
        <a
          href={buyNowMailto()}
          class="hidden lg:inline-flex min-h-12 items-center justify-center px-5 py-3 text-base font-semibold rounded-2xl bg-[color:var(--color-fg)] text-[color:var(--color-bg)] hover:opacity-90 transition-all active:scale-[0.985]"
        >
          Buy Now
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden relative z-[60] tap-target inline-flex items-center justify-center rounded-2xl border border-[color:var(--color-border)] text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)] hover:bg-[color:var(--color-surface)] transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="menu-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 pointer-events-none"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<div
  id="mobile-menu"
  class="hidden lg:hidden fixed top-20 inset-x-0 bottom-0 z-[55] overflow-y-auto bg-[var(--color-bg)]"
>
  <div class="px-6 py-8 flex flex-col gap-y-1 text-lg font-medium">
    <a href="#positioning" class="mobile-nav-link inline-flex min-h-12 items-center py-3"
      >Positioning</a
    >
    <a href="#why" class="mobile-nav-link inline-flex min-h-12 items-center py-3">Why Buy</a>
    <a href="#insights" class="mobile-nav-link inline-flex min-h-12 items-center py-3"
      >Insights</a
    >
    <a href="#pricing" class="mobile-nav-link inline-flex min-h-12 items-center py-3"
      >Pricing</a
    >
    <a href="/blog/" class="mobile-nav-link inline-flex min-h-12 items-center py-3">Blog</a>
    <a href="#inquire" class="mobile-nav-link inline-flex min-h-12 items-center py-3"
      >Make Offer</a
    >
    <div class="pt-4 border-t border-[color:var(--color-border)] space-y-3">
      <a
        href={buyNowMailto()}
        class="flex min-h-12 w-full items-center justify-center text-center py-3.5 rounded-2xl btn-primary"
      >
        Buy Now — Secure Domain
      </a>
      <a
        href={acquisitionMailto()}
        class="flex min-h-12 w-full items-center justify-center text-center py-3.5 rounded-2xl border border-[color:var(--color-border)]"
      >
        Contact Agent
      </a>
    </div>
  </div>
</div>

<script>
  function syncThemeIcons() {
    const theme = document.documentElement.getAttribute('data-theme');
    const darkIcon = document.querySelector('.theme-icon-dark');
    const lightIcon = document.querySelector('.theme-icon-light');
    if (theme === 'light') {
      darkIcon?.classList.add('hidden');
      lightIcon?.classList.remove('hidden');
    } else {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    }
    const meta = document.getElementById('theme-color-meta');
    if (meta) meta.setAttribute('content', theme === 'light' ? '#f4f6fb' : '#0a0a0f');
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (_) {}
    syncThemeIcons();
  });
  syncThemeIcons();

  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const icon = document.getElementById('menu-icon');
    const links = document.querySelectorAll('.mobile-nav-link');

    const close = () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (icon) {
        icon.innerHTML =
          '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
      }
    };

    btn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const open = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
      if (icon) {
        icon.innerHTML = open
          ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />'
          : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
      }
    });

    links.forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  function initSmoothScroll() {
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        const href = this.getAttribute('href');
        const targetId = href?.substring(1);
        const target = targetId ? document.getElementById(targetId) : null;
        if (target) {
          e.preventDefault();
          const offset = 80;
          const top =
            target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });
  }

  initMobileMenu();
  initSmoothScroll();
</script>
