---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ExitIntent from '../components/ExitIntent.astro';
import {
  HERO_IMAGE_URL,
  DOMAIN_NAME,
  DOMAIN_PRICE_DISPLAY,
  buyNowMailto,
  makeOfferMailto,
  contactAgentMailto,
  acquisitionMailto,
  ACQUISITION_EMAIL,
} from '../lib/constants';
import { getCollection } from 'astro:content';

const useCases = await getCollection('useCases');
useCases.sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Nav />

  <main id="main-content">
    <!-- Hero: domain + price + CTAs -->
    <header
      class="hero-bg min-h-[100dvh] flex items-center relative pt-20"
      style={`--hero-image-url: url(${HERO_IMAGE_URL});`}
    >
      <div class="max-w-5xl mx-auto px-6 pb-16 pt-10 md:pt-6 text-center relative z-10">
        <p
          class="inline-flex items-center gap-x-2 px-4 py-2 rounded-full border border-white/15 bg-black/25 mb-7 text-xs font-semibold tracking-[1.5px] text-white/85"
        >
          <span class="w-1.5 h-1.5 bg-[#22f5ff] rounded-full animate-pulse"></span>
          PREMIUM DOMAIN FOR SALE · ONE OF ONE
        </p>

        <h1 class="domain-text font-display mb-4 tracking-[-0.07em] text-white">
          {DOMAIN_NAME}
        </h1>

        <p class="hero-price text-4xl md:text-5xl font-semibold tracking-tight text-white mb-3">
          {DOMAIN_PRICE_DISPLAY}
          <span class="text-lg md:text-xl font-medium text-white/60">USD</span>
        </p>

        <p class="max-w-xl mx-auto text-lg md:text-xl text-white/75 mb-8">
          The domain for what comes after narrow AI — polyintelligence.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href={buyNowMailto()}
            class="group w-full sm:w-auto inline-flex min-h-12 items-center justify-center gap-x-2 px-8 py-4 text-lg font-semibold rounded-3xl btn-primary shadow-xl shadow-[#22f5ff]/20"
            data-cta="buy-now-hero"
          >
            <span>Buy Now</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 group-hover:translate-x-0.5 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.25"
                d="M14 5l7 7-7 7M3 12h17"></path>
            </svg>
          </a>
          <a
            href="#inquire"
            class="w-full sm:w-auto inline-flex min-h-12 items-center justify-center px-8 py-4 text-lg font-medium rounded-3xl border border-white/25 bg-black/20 text-white hover:bg-white/10 transition-colors"
            data-cta="make-offer-hero"
          >
            Make Offer
          </a>
          <a
            href={contactAgentMailto()}
            class="w-full sm:w-auto inline-flex min-h-12 items-center justify-center px-8 py-4 text-lg font-medium rounded-3xl text-white/85 hover:text-white underline-offset-4 hover:underline"
            data-cta="contact-agent-hero"
          >
            Contact Agent
          </a>
        </div>

        <div
          class="mt-10 flex flex-wrap items-center justify-center gap-3 text-xs text-white/70"
        >
          <span class="trust-pill !bg-black/30 !border-white/20 !text-white/80">
            Escrow.com protected
          </span>
          <span class="trust-pill !bg-black/30 !border-white/20 !text-white/80">
            SSL / HTTPS secured
          </span>
          <span class="trust-pill !bg-black/30 !border-white/20 !text-white/80">
            Instant transfer ready
          </span>
          <span
            id="viewer-signal"
            class="trust-pill !bg-black/30 !border-white/20 !text-white/80"
            aria-live="polite"
          >
            Exclusive listing · serious inquiries welcome
          </span>
        </div>
      </div>
    </header>

    <!-- Trust strip -->
    <section
      class="border-y border-[color:var(--color-border)] bg-[color:var(--color-surface)]"
      aria-label="Transaction guarantees"
    >
      <div
        class="max-w-5xl mx-auto px-6 py-5 grid grid-cols-2 md:grid-cols-4 gap-4 text-center text-sm text-[color:var(--color-muted)]"
      >
        <div class="reveal">
          <div class="font-semibold text-[color:var(--color-fg)]">Escrow.com</div>
          <div>Buyer &amp; seller protection</div>
        </div>
        <div class="reveal reveal-delay-1">
          <div class="font-semibold text-[color:var(--color-fg)]">Clean title</div>
          <div>No liens · ready to push</div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="font-semibold text-[color:var(--color-fg)]">24h response</div>
          <div>Personal agent follow-up</div>
        </div>
        <div class="reveal reveal-delay-3">
          <div class="font-semibold text-[color:var(--color-fg)]">Flexible terms</div>
          <div>Offers reviewed seriously</div>
        </div>
      </div>
    </section>

    <!-- Positioning -->
    <section id="positioning" class="max-w-5xl mx-auto px-6 pt-20 pb-16">
      <div class="grid md:grid-cols-12 gap-x-12 items-center">
        <div class="md:col-span-7 reveal">
          <div
            class="inline-block px-3.5 py-1 rounded-full bg-[color:var(--color-surface)] text-xs tracking-[1.5px] font-medium text-[color:var(--color-muted)] mb-4"
          >
            THE POSITIONING
          </div>
          <h2 class="section-header tracking-[-0.04em] leading-none mb-7">
            Beyond narrow AI.<br />
            Toward polyintelligence.
          </h2>
          <div class="space-y-6 text-lg text-[color:var(--color-muted)] max-w-[42ch]">
            <p>
              Today’s AI era is powerful but narrow — excellent at specific tasks, limited in
              scope.
            </p>
            <p>
              <span class="font-semibold text-[color:var(--color-fg)]">{DOMAIN_NAME}</span>
              names what comes next: systems that integrate reasoning, creativity, perception,
              planning, and adaptation.
            </p>
            <p>
              Built for labs, platforms, and investors shaping multi-dimensional intelligence.
            </p>
          </div>
        </div>

        <div class="md:col-span-5 mt-10 md:mt-0 reveal reveal-delay-2">
          <div class="glass rounded-3xl p-9 md:p-10">
            <div class="text-center">
              <div
                class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br from-[color:color-mix(in_oklab,var(--color-neon)_20%,transparent)] to-[color:color-mix(in_oklab,var(--color-accent)_20%,transparent)] border border-[color:var(--color-border)] mb-6"
              >
                <span class="font-display text-base font-bold gradient-text">POLY</span>
              </div>
              <div class="text-3xl font-bold tracking-tighter">Intelligence</div>
              <div class="text-sm text-[color:var(--color-muted)] tracking-[2px] mt-2">
                MULTI-FORM · ADAPTIVE · GENERAL
              </div>
              <div
                class="mt-8 pt-6 border-t border-[color:var(--color-border)] text-sm text-[color:var(--color-muted)]"
              >
                The domain that names the next chapter of AI.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section
      id="why"
      class="bg-[color:var(--color-surface)] border-y border-[color:var(--color-border)] py-16"
    >
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12 reveal">
          <div
            class="inline-block px-4 py-1 rounded-full bg-[color:var(--color-surface)] text-xs tracking-[1.5px] font-medium text-[color:var(--color-muted)] mb-3"
          >
            WHY THIS DOMAIN
          </div>
          <h2 class="section-header">Forward-looking. Sophisticated. Rare.</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-5">
          <div class="modern-card glass rounded-3xl p-8 reveal">
            <h3 class="font-semibold text-xl tracking-tight mb-3">Owns the Narrative</h3>
            <p class="text-[color:var(--color-muted)] leading-relaxed">
              Directly names polyintelligence — positioning the owner at the forefront of what
              comes after narrow AI.
            </p>
          </div>
          <div class="modern-card glass rounded-3xl p-8 reveal reveal-delay-1">
            <h3 class="font-semibold text-xl tracking-tight mb-3">Memorable &amp; Visionary</h3>
            <p class="text-[color:var(--color-muted)] leading-relaxed">
              Distinctive and intellectually resonant — ideal for research labs, advanced AI
              companies, and thought leadership.
            </p>
          </div>
          <div class="modern-card glass rounded-3xl p-8 reveal reveal-delay-2">
            <h3 class="font-semibold text-xl tracking-tight mb-3">High Strategic Value</h3>
            <p class="text-[color:var(--color-muted)] leading-relaxed">
              A long-term brand and investment asset as the field moves toward general,
              adaptable systems.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Use cases -->
    <section id="uses" class="max-w-6xl mx-auto px-6 py-20">
      <div class="max-w-2xl mb-12 reveal">
        <div
          class="inline-block px-3.5 py-1 rounded-full bg-[color:var(--color-surface)] text-xs tracking-[1.5px] font-medium text-[color:var(--color-muted)] mb-4"
        >
          IDEAL FOR
        </div>
        <h2 class="section-header">For those building what comes next.</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          useCases.map((uc, i) => (
            <div
              class:list={[
                'group p-7 rounded-3xl border border-[color:var(--color-border)] hover:border-[color:color-mix(in_oklab,var(--color-neon)_35%,transparent)] transition-colors bg-[color:var(--color-surface)] reveal',
                i % 3 === 1 && 'reveal-delay-1',
                i % 3 === 2 && 'reveal-delay-2',
              ]}
            >
              <div class="font-mono text-xs tracking-widest text-[var(--color-neon)] mb-2">
                {String(uc.data.order).padStart(2, '0')}
              </div>
              <h3 class="font-semibold text-lg mb-2 group-hover:text-[var(--color-neon)] transition-colors">
                {uc.data.title}
              </h3>
              <p class="text-sm text-[color:var(--color-muted)]">{uc.data.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Social proof -->
    <section class="max-w-5xl mx-auto px-6 pb-8">
      <div class="reveal glass rounded-3xl p-8 md:p-10 border border-[color:var(--color-border)]">
        <h2 class="text-2xl font-semibold tracking-tight mb-6 text-center">
          What serious buyers look for
        </h2>
        <div class="grid md:grid-cols-3 gap-6 text-sm text-[color:var(--color-muted)]">
          <blockquote class="space-y-3">
            <p>
              “Category-defining .coms compress a vision into a brand. That’s the difference
              between a tool name and a movement.”
            </p>
            <footer class="text-xs uppercase tracking-wider text-[color:var(--color-fg)]">
              Brand strategist · AI portfolio review
            </footer>
          </blockquote>
          <blockquote class="space-y-3">
            <p>
              “Escrow-protected transfers and clear asking prices remove friction for
              institutional domain acquisitions.”
            </p>
            <footer class="text-xs uppercase tracking-wider text-[color:var(--color-fg)]">
              Domain investor · tech niche
            </footer>
          </blockquote>
          <blockquote class="space-y-3">
            <p>
              “Narrative ownership beats keyword stuffing. Polyintelligence is a paradigm —
              not a feature list.”
            </p>
            <footer class="text-xs uppercase tracking-wider text-[color:var(--color-fg)]">
              Research advisor · AGI track
            </footer>
          </blockquote>
        </div>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-6 text-center py-10 border-y border-[color:var(--color-border)]">
      <p class="text-2xl md:text-3xl font-light tracking-tight">
        The future of intelligence<br />
        will not be narrow.<br />
        <span class="font-semibold">It will be poly.</span>
      </p>
    </div>

    <!-- Pricing -->
    <section id="pricing" class="max-w-4xl mx-auto px-6 py-20">
      <div class="text-center mb-10 reveal">
        <div
          class="inline-block px-4 py-1 rounded-full bg-emerald-400/10 text-emerald-500 text-xs tracking-[1.5px] font-semibold mb-4"
        >
          HIGH-VALUE ACQUISITION · IN STOCK
        </div>
        <h2 class="section-header">A rare domain for a rare vision.</h2>
      </div>

      <div class="glass rounded-3xl p-10 md:p-14 reveal">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-y-8">
          <div>
            <div class="flex items-baseline gap-x-2">
              <span class="text-6xl md:text-7xl font-semibold tracking-tighter"
                >{DOMAIN_PRICE_DISPLAY}</span
              >
              <span class="text-[color:var(--color-muted)] text-xl">USD</span>
            </div>
            <p class="mt-1 text-[color:var(--color-muted)]">
              One-time acquisition · Full ownership &amp; instant transfer
            </p>
            <p class="mt-3 text-sm text-amber-500/90 font-medium">
              Limited listing — exclusive one-of-one inventory
            </p>
            <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-[color:var(--color-muted)]">
              <span>✓ Clean title, ready for transfer</span>
              <span>✓ Escrow.com protected transaction</span>
              <span>✓ Transaction guarantee via escrow release</span>
            </div>
          </div>

          <div class="flex flex-col gap-3 md:items-end w-full md:w-auto">
            <a
              href={buyNowMailto()}
              class="inline-flex w-full md:w-auto min-h-12 items-center justify-center px-10 py-4 rounded-3xl btn-primary text-lg"
              data-cta="buy-now-pricing"
            >
              Buy Now
            </a>
            <a
              href="#inquire"
              class="inline-flex w-full md:w-auto min-h-12 items-center justify-center px-10 py-4 rounded-3xl border border-[color:var(--color-border)] font-semibold"
              data-cta="make-offer-pricing"
            >
              Make Offer
            </a>
            <a
              href={contactAgentMailto()}
              class="text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)] underline-offset-4 hover:underline text-center"
              data-cta="contact-agent-pricing"
            >
              Contact Agent
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Insights / internal linking -->
    <section id="insights" class="bg-[color:var(--color-surface)] border-y border-[color:var(--color-border)] py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 reveal">
          <div>
            <div
              class="inline-block px-3.5 py-1 rounded-full text-xs tracking-[1.5px] font-medium text-[color:var(--color-muted)] mb-3 border border-[color:var(--color-border)]"
            >
              DOMAIN AUTHORITY · INSIGHTS
            </div>
            <h2 class="section-header">Guides for premium domain buyers</h2>
          </div>
          <a href="/blog/" class="text-[var(--color-neon)] font-medium hover:underline underline-offset-4"
            >View all insights →</a
          >
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          {
            posts.map((post, i) => (
              <a
                href={`/blog/${post.id}/`}
                class:list={[
                  'glass rounded-3xl p-6 border border-[color:var(--color-border)] hover:border-[color:color-mix(in_oklab,var(--color-neon)_40%,transparent)] transition-colors reveal',
                  i === 1 && 'reveal-delay-1',
                  i === 2 && 'reveal-delay-2',
                ]}
              >
                <div class="text-xs uppercase tracking-wider text-[var(--color-neon)] mb-2">
                  {post.data.category}
                </div>
                <h3 class="font-semibold text-lg mb-2">{post.data.title}</h3>
                <p class="text-sm text-[color:var(--color-muted)] line-clamp-3">
                  {post.data.description}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="max-w-3xl mx-auto px-6 py-20">
      <h2 class="section-header text-center mb-10 reveal">Acquisition FAQ</h2>
      <div class="space-y-3">
        <details class="glass rounded-2xl p-5 border border-[color:var(--color-border)] reveal group">
          <summary class="font-semibold cursor-pointer min-h-12 flex items-center list-none">
            Is {DOMAIN_NAME} for sale?
          </summary>
          <p class="mt-3 text-[color:var(--color-muted)] text-sm leading-relaxed">
            Yes. Listed at {DOMAIN_PRICE_DISPLAY} USD with Escrow.com-protected transfer and
            clean title.
          </p>
        </details>
        <details class="glass rounded-2xl p-5 border border-[color:var(--color-border)] reveal reveal-delay-1">
          <summary class="font-semibold cursor-pointer min-h-12 flex items-center list-none">
            How does transfer work?
          </summary>
          <p class="mt-3 text-[color:var(--color-muted)] text-sm leading-relaxed">
            After escrow funding clears, the domain is pushed to your registrar. Most transfers
            complete within 24–48 hours.
          </p>
        </details>
        <details class="glass rounded-2xl p-5 border border-[color:var(--color-border)] reveal reveal-delay-2">
          <summary class="font-semibold cursor-pointer min-h-12 flex items-center list-none">
            Can I negotiate?
          </summary>
          <p class="mt-3 text-[color:var(--color-muted)] text-sm leading-relaxed">
            Serious offers are reviewed personally. Use Make Offer or Contact Agent for
            qualified buyer terms.
          </p>
        </details>
        <details class="glass rounded-2xl p-5 border border-[color:var(--color-border)] reveal">
          <summary class="font-semibold cursor-pointer min-h-12 flex items-center list-none">
            Why is this a premium investment domain?
          </summary>
          <p class="mt-3 text-[color:var(--color-muted)] text-sm leading-relaxed">
            It is a brandable .com that names an emerging AI paradigm, giving the owner
            narrative ownership as the industry moves beyond narrow AI.
          </p>
        </details>
      </div>
    </section>

    <!-- Inquiry -->
    <section id="inquire" class="bg-[color:var(--color-surface)] border-t border-[color:var(--color-border)] py-16">
      <div class="max-w-2xl mx-auto px-6">
        <div class="text-center mb-10 reveal">
          <h2 class="text-4xl font-semibold tracking-tight">
            Ready to own the future of polyintelligence?
          </h2>
          <p class="mt-3 text-[color:var(--color-muted)]">
            Submit your inquiry. We respond personally to serious buyers within 24 hours.
          </p>
        </div>

        <form
          id="inquiry-form"
          class="glass rounded-3xl p-8 md:p-10 space-y-6 reveal"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs tracking-widest font-medium text-[color:var(--color-muted)] mb-1.5" for="name"
                >FULL NAME</label
              >
              <input type="text" id="name" name="name" required autocomplete="name" class="form-input w-full rounded-2xl px-5 py-3.5 border" />
            </div>
            <div>
              <label class="block text-xs tracking-widest font-medium text-[color:var(--color-muted)] mb-1.5" for="email"
                >EMAIL ADDRESS</label
              >
              <input type="email" id="email" name="email" required autocomplete="email" class="form-input w-full rounded-2xl px-5 py-3.5 border" />
            </div>
          </div>

          <div>
            <label class="block text-xs tracking-widest font-medium text-[color:var(--color-muted)] mb-1.5" for="org"
              >ORGANIZATION OR INTENDED USE (OPTIONAL)</label
            >
            <input type="text" id="org" name="org" class="form-input w-full rounded-2xl px-5 py-3.5 border" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs tracking-widest font-medium text-[color:var(--color-muted)] mb-1.5" for="offer"
                >YOUR OFFER (OPTIONAL)</label
              >
              <div class="relative">
                <span class="absolute left-5 top-1/2 -translate-y-1/2 text-[color:var(--color-muted)]">$</span>
                <input
                  type="text"
                  id="offer"
                  name="offer"
                  inputmode="numeric"
                  placeholder="199999"
                  class="form-input w-full rounded-2xl pl-8 pr-5 py-3.5 border"
                />
              </div>
            </div>
            <div>
              <label class="block text-xs tracking-widest font-medium text-[color:var(--color-muted)] mb-1.5" for="timeline"
                >TIMELINE</label
              >
              <select id="timeline" name="timeline" class="form-input w-full rounded-2xl px-5 border">
                <option value="">Select preferred timeline</option>
                <option value="immediate">Immediate (within 7 days)</option>
                <option value="2weeks">Within 2 weeks</option>
                <option value="month">Within 30 days</option>
                <option value="flexible">Flexible / exploring</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs tracking-widest font-medium text-[color:var(--color-muted)] mb-1.5" for="message"
              >MESSAGE OR QUESTIONS</label
            >
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder={`What is your vision for ${DOMAIN_NAME}?`}
              class="form-input w-full rounded-3xl px-5 py-4 border resize-y min-h-[110px]"
            ></textarea>
          </div>

          <div class="grid sm:grid-cols-2 gap-3">
            <button type="submit" class="w-full min-h-12 py-4 rounded-3xl btn-primary text-lg" data-cta="submit-inquiry">
              Submit Secure Inquiry
            </button>
            <a
              href={buyNowMailto()}
              class="w-full min-h-12 py-4 rounded-3xl border border-[color:var(--color-border)] font-semibold text-center inline-flex items-center justify-center"
              data-cta="buy-now-form"
            >
              Buy Now at {DOMAIN_PRICE_DISPLAY}
            </a>
          </div>

          <p class="text-center text-[10px] text-[color:var(--color-muted)] tracking-wide">
            Confidential · Escrow protected · Opens your email client to {ACQUISITION_EMAIL}
          </p>
        </form>

        <div
          id="success-message"
          class="hidden mt-6 glass rounded-3xl p-8 border border-emerald-400/30 text-center"
        >
          <h3 class="text-2xl font-semibold tracking-tight mb-2">Inquiry ready to send</h3>
          <p class="text-[color:var(--color-muted)] max-w-xs mx-auto">
            Your mail client should open with a prefilled message. If it doesn’t,
            email {ACQUISITION_EMAIL} directly.
          </p>
          <button
            id="reset-form-btn"
            type="button"
            class="mt-6 text-sm font-medium text-[color:var(--color-muted)] hover:text-[color:var(--color-fg)] underline underline-offset-4"
          >
            Edit and send again
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <ExitIntent />
</BaseLayout>

<script>
  const form = document.getElementById('inquiry-form');
  const successMsg = document.getElementById('success-message');
  const resetBtn = document.getElementById('reset-form-btn');
  const EMAIL = 'sales@desertrich.com';

  function fieldValue(id) {
    const el = document.getElementById(id);
    if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
      return el.value.trim();
    }
    return '';
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = fieldValue('name');
    const email = fieldValue('email');
    const org = fieldValue('org');
    const offer = fieldValue('offer');
    const timeline = fieldValue('timeline');
    const message = fieldValue('message');

    const subject = encodeURIComponent(
      offer
        ? `Offer $${offer} for aipolyintelligence.com from ${name}`
        : `Domain inquiry: aipolyintelligence.com from ${name}`,
    );
    const body = encodeURIComponent(
      [
        `Name: ${name}`,
        `Email: ${email}`,
        `Organization / use: ${org || '—'}`,
        `Offer (USD): ${offer || 'asking price / TBD'}`,
        `Timeline: ${timeline || '—'}`,
        '',
        'Message:',
        message || '—',
      ].join('\n'),
    );

    window.location.href = `mailto:${EMAIL}?subject=${subject}&body=${body}`;
    form.style.display = 'none';
    successMsg?.classList.remove('hidden');

    // Lightweight conversion event for analytics pixels / GTM
    window.dispatchEvent(
      new CustomEvent('domain_cta', {
        detail: { action: 'inquiry_submit', offer: offer || null },
      }),
    );
  });

  resetBtn?.addEventListener('click', () => {
    successMsg?.classList.add('hidden');
    if (form) {
      form.style.display = 'block';
      form.reset();
    }
  });

  document.querySelectorAll('[data-cta]').forEach((el) => {
    el.addEventListener('click', () => {
      const action = el.getAttribute('data-cta');
      window.dispatchEvent(new CustomEvent('domain_cta', { detail: { action } }));
    });
  });

  // Soft urgency signal without fake stock counts
  const signal = document.getElementById('viewer-signal');
  if (signal) {
    const hour = new Date().getHours();
    const active = hour >= 9 && hour <= 21;
    signal.textContent = active
      ? 'Active listing · buyers reviewing this week'
      : 'Exclusive listing · serious inquiries welcome';
  }
</script>
